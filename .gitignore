# ---------- 构建产物 ----------
build/
app/build/
.gradle/
# 机器相关（里面是本机 SDK 绝对路径），绝不能提交
local.properties

# ---------- 由构建生成，真源是项目根目录的 template.docx ----------
# 见 app/build.gradle.kts 的 syncTemplate 任务。不要手工编辑这一份。
app/src/main/assets/template.docx

# ---------- 签名密钥：绝对不要提交 ----------
# 这是这个 app 的身份证，泄露的后果有两个，都很实在：
#   1. 任何人都能签出你手机愿意接受的"更新包"；
#   2. 它一旦丢失，你就再也无法覆盖升级，只能卸载重装 —— 记录全丢。
# 换机器时手工拷贝这个文件，不要走仓库。
tools/attendance.keystore

# ---------- 交付用的 apk（属于构建产物）----------
*.apk

# ---------- 编辑器 / 系统 ----------
.idea/
*.iml
.DS_Store
